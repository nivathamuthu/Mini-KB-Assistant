# Host port 5433 avoids clash with a local PostgreSQL install on 5432 (see DB_HOST_PORT).
DATABASE_URL=postgresql+asyncpg://kb:kb@localhost:5433/kb
DB_HOST_PORT=5433

# pgAdmin (Docker service pgadmin) — local dev only
PGADMIN_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin

# --- Provider-style env (recommended) ------------------------------------
LLM_PROVIDER=google
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Chat model. Empty = provider default (see GEMINI_MODEL fallback).
LLM_MODEL=gemini-3.5-flash-lite
# Local CPU embedding model (when set, used instead of API embeddings).
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Legacy aliases (still supported) ------------------------------------
# PROVIDER=mock
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_MODEL=text-embedding-3-small

# bge-small-en-v1.5 = 384; Gemini API embeddings = 768; OpenAI = 1536
EMBEDDING_DIM=384

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE_SCORE=0.15
MAX_DOC_CHARS=200000
MAX_TITLE_CHARS=200
MAX_QUESTION_CHARS=1000
RATE_LIMIT_PER_MINUTE=20
UPSTREAM_TIMEOUT_SECONDS=20
UPSTREAM_MAX_RETRIES=2
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
